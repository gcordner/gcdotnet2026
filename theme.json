{
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1140px",
      "wideSize": "1140px"
    },
    "color": {
      "defaultPalette": false,
      "custom": false,
      "palette": [
        { "slug": "white", "color": "#FFFFFF", "name": "White" },
        { "slug": "off-white", "color": "#f4fafb", "name": "Off White" },
        { "slug": "black", "color": "#0d0d0d", "name": "Black" },
        { "slug": "body-text", "color": "#212529", "name": "Body Text" },
        { "slug": "light-blue", "color": "#b4d2d9", "name": "Light Blue" },
        { "slug": "blue", "color": "#2675a6", "name": "Blue" },
        { "slug": "steel-blue", "color": "#498ba6", "name": "Steel Blue" },
        { "slug": "dark-blue", "color": "#162c40", "name": "Dark Blue" },
        { "slug": "grey-light", "color": "#F0F0F0", "name": "Light Grey" },
        { "slug": "grey-dark", "color": "#5b5e5f", "name": "Dark Grey" },
        { "slug": "grey", "color": "#8B8B8B", "name": "Grey" },
        { "slug": "yellow", "color": "#F2B035", "name": "Yellow" },
        { "slug": "transparent", "color": "transparent", "name": "Transparent" }
      ]
    },
    "typography": {
      "fontSizes": [
        { "slug": "medium", "size": "18px", "name": "Medium" },
        { "slug": "large", "size": "32px", "name": "Large" },
        { "slug": "x-large", "size": "40px", "name": "Extra Large" }
      ],
      "fontFamilies": [
        {
          "fontFamily": "'Bebas Neue', sans-serif",
          "name": "Bebas Neue",
          "slug": "bebas-neue",
          "fontFace": [
            {
              "fontFamily": "Bebas Neue",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/BebasNeue-Regular.woff2"]
            }
          ]
        },
        {
          "fontFamily": "'Montserrat', sans-serif",
          "name": "Montserrat",
          "slug": "montserrat",
          "fontFace": [
            {
              "fontFamily": "Montserrat",
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "src": ["file:./assets/fonts/Montserrat-VariableFont_wght.woff2"]
            },
            {
              "fontFamily": "Montserrat",
              "fontWeight": "100 900",
              "fontStyle": "italic",
              "src": [
                "file:./assets/fonts/Montserrat-Italic-VariableFont_wght.woff2"
              ]
            }
          ]
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--body-text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--montserrat)",
      "fontSize": "var(--wp--preset--font-size--medium)"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--bebas-neue)",
          "fontWeight": "400",
          "lineHeight": "1.2"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--blue)"
        },
        ":hover": {
          "color": {
            "text": "#1e5e85"
          }
        }
      }
    },
    "blocks": {
      "core/button": {
        "color": {
          "background": "var(--wp--preset--color--dark-blue)",
          "text": "var(--wp--preset--color--white)"
        }
      }
    }
  }
}
