{
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1140px",
      "wideSize": "1140px"
    },
    "color": {
      "defaultPalette": false,
      "custom": false,
      "palette": [
        {
          "name": "White",
          "color": "#FFFFFF",
          "slug": "white"
        },
        {
          "name": "Off White",
          "color": "#f4fafb",
          "slug": "off-white"
        },
        {
          "name": "Black",
          "color": "#0d0d0d",
          "slug": "black"
        },
        {
          "name": "Body Text",
          "color": "#212529",
          "slug": "body-text"
        },
        {
          "name": "Light Blue",
          "color": "#b4d2d9",
          "slug": "light-blue"
        },
        {
          "name": "Blue",
          "color": "#2675a6",
          "slug": "blue"
        },
        {
          "name": "Steel Blue",
          "color": "#498ba6",
          "slug": "steel-blue"
        },
        {
          "name": "Dark Blue",
          "color": "#162c40",
          "slug": "dark-blue"
        },
        {
          "name": "Light Grey",
          "color": "#F0F0F0",
          "slug": "grey-light"
        },
        {
          "name": "Dark Grey",
          "color": "#5b5e5f",
          "slug": "grey-dark"
        },
        {
          "name": "Grey",
          "color": "#8B8B8B",
          "slug": "grey"
        },
        {
          "name": "Yellow",
          "color": "#F2B035",
          "slug": "yellow"
        },
        {
          "name": "Transparent",
          "color": "transparent",
          "slug": "transparent"
        }
      ]
    },
    "typography": {
      "fluid": true,
      "fontSizes": [
        {
          "name": "Small",
          "size": "0.85rem",
          "slug": "small",
          "fluid": false
        },
        {
          "name": "Medium",
          "size": "1rem",
          "slug": "medium",
          "fluid": false
        },
        {
          "name": "Medium Large",
          "size": "1.15rem",
          "slug": "medium-large",
          "fluid": false
        },
        {
          "name": "Large",
          "size": "1.5rem",
          "slug": "large",
          "fluid": {
            "min": "1.15rem",
            "max": "1.5rem"
          }
        },
        {
          "name": "Extra Large",
          "size": "2rem",
          "slug": "x-large",
          "fluid": {
            "min": "1.5rem",
            "max": "2rem"
          }
        },
        {
          "name": "XX Large",
          "size": "2.5rem",
          "slug": "xx-large",
          "fluid": {
            "min": "2rem",
            "max": "2.5rem"
          }
        }
      ],
      "fontFamilies": [
        {
          "fontFamily": "'Bebas Neue', sans-serif",
          "name": "Bebas Neue",
          "slug": "bebas-neue",
          "fontFace": [
            {
              "fontFamily": "Bebas Neue",
              "fontWeight": "400",
              "fontStyle": "normal",
              "src": [
                "file:./assets/fonts/BebasNeue-Regular.woff2"
              ]
            }
          ]
        },
        {
          "fontFamily": "'Montserrat', sans-serif",
          "name": "Montserrat",
          "slug": "montserrat",
          "fontFace": [
            {
              "fontFamily": "Montserrat",
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "src": [
                "file:./assets/fonts/Montserrat-VariableFont_wght.woff2"
              ]
            },
            {
              "fontFamily": "Montserrat",
              "fontWeight": "100 900",
              "fontStyle": "italic",
              "src": [
                "file:./assets/fonts/Montserrat-Italic-VariableFont_wght.woff2"
              ]
            }
          ]
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--body-text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--montserrat)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.625",
      "letterSpacing": "0.05625em"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--bebas-neue)",
          "fontWeight": "400",
          "lineHeight": "1.2"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--blue)"
        },
        ":hover": {
          "color": {
            "text": "#1e5e85"
          }
        }
      }
    },
    "blocks": {
      "core/button": {
        "color": {
          "background": "var(--wp--preset--color--dark-blue)",
          "text": "var(--wp--preset--color--white)"
        }
      }
    }
  }
}
